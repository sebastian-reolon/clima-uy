<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<meta name="description" content="{% block description %}{% endblock %}">
<link rel="stylesheet" href="{{ base }}/static/v2/css/site.css">
<link rel="preload" href="{{ base }}/static/v2/fonts/barlow-400-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
<a class="skip" href="#contenido">Ir al contenido</a>
{# Until the home becomes the river summary, the old El Niño home ("home") also marks Río. #}
{% set rio_current = nav in ("home", "rio") %}
<div class="hoja"><div class="marco">
<header class="top"><a class="marca" href="{{ base }}/">clima-uy</a><nav aria-label="Secciones"><a href="{{ base }}/"{% if rio_current %} aria-current="page"{% endif %}>Río</a><a href="{{ base }}/nino/"{% if nav == "nino" %} aria-current="page"{% endif %}>El Niño</a><a href="{{ base }}/datos/"{% if nav == "datos" %} aria-current="page"{% endif %}>Datos</a></nav></header>
<main id="contenido">
{% block main %}{% endblock %}
<section class="sec"><h2>Notas</h2>
<ol class="notas">
<li>Esto no es una alerta oficial. Para alertas y evacuaciones: <a href="{{ sinae_url }}">SINAE</a> y el CECOED de tu departamento.</li>
{% block notes %}{% endblock %}
</ol></section>
</main>
<footer class="pie"><span class="credit">Hecho por <a href="{{ author_url }}">Sebastián Reolon</a></span><span>Código y datos en <a href="{{ repo_url }}">el repositorio público</a></span><span>Fuentes: {% for name, url in sources %}<a href="{{ url }}">{{ name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% if sheet %}<span>Hoja {{ sheet }} de 5</span>{% endif %}</footer>
</div></div>
{% block scripts %}{% endblock %}
</body>
</html>
