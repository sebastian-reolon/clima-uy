{% extends "base.html.j2" %}
{# Sheet 3: the river day by day. Ported from the approved mockup d-crecida.html (2026-11-02).
   The diagram is static SVG; the day selector is the only script and only redraws the day profile. #}
{% block title %}La crecida, día por día | clima-uy{% endblock %}
{% block description %}Los últimos {{ window_days }} días del río Uruguay, {{ stretch }}: cada estación comparada con su propia historia, día por día, con la matriz en CSV.{% endblock %}
{% block main %}
<div class="cab">
<section class="resp"><h1>La crecida, día por día</h1>
<p>Los últimos {{ window_days }} días del río, {{ stretch }}. Una crecida que baja se ve como una franja oscura en diagonal: cuanto más inclinada, más lento viaja el agua.</p>
<p class="crumb"><a href="{{ base }}/rio/">El río estación por estación</a></p>
</section>
<dl class="cajetin">
{% for label, value in cajetin %}
<dt>{{ label }}</dt><dd>{{ value }}</dd>
{% endfor %}
<dt>Datos</dt><dd><a href="{{ base }}/{{ csv_path }}" download>matriz en CSV</a></dd>
<dt>Carácter</dt><dd>{{ character }}</dd>
</dl>
</div>
<section class="sec"><h2>El río en los últimos {{ window_days }} días</h2>
<p class="que">Columnas: estaciones en el orden en que baja el agua. Filas: días, el más reciente abajo. Color: percentil de ese día contra la historia de cada estación desde 1990, o desde que tiene datos. Los puntos rojos son los picos de cada estación: si se alinean en diagonal, es la misma crecida bajando.</p>
{{ hov_wide }}{{ hov_phone }}
<p class="escala">{% for label in bands %}<span><i class="h{{ loop.index0 }}"></i>{{ label }}</span>{% endfor %}<span>blanco: sin dato</span></p>
</section>
<section class="sec"><h2>Un día</h2>
<p class="que">Elegí un día tocando una fila del diagrama o con el control. Abajo, el perfil del río ese día.</p>
<noscript><p>Para elegir un día hace falta JavaScript. El diagrama de arriba se lee completo sin él.</p></noscript>
<div class="dia" id="dia-control" hidden><label for="dia">Día</label><input id="dia" type="range" min="0" max="{{ window_days - 1 }}" value="{{ window_days - 1 }}" step="1"><output id="dia-txt" for="dia"></output></div>
<div id="dia-perfil" hidden><svg id="perfil-dia" class="perfil-dia" viewBox="0 0 1100 250" role="img" aria-label="Perfil del río el día elegido"></svg></div>
</section>
{% endblock %}
{% block notes %}
<li>Entran las estaciones con {{ min_years }} años o más de historia y dato en al menos {{ min_coverage }}% de los días de la ventana.{% if skipped_history %} Sin {{ min_years }} años de historia: {{ skipped_history }}.{% endif %}{% if skipped_gaps %} Con huecos en estos días: {{ skipped_gaps }}.{% endif %}</li>
{% if partial %}<li>La última fila es hoy y se completa a medida que llegan datos.</li>
{% endif %}<li>Un pico es un día más alto que los {{ peak_days }} días anteriores y los {{ peak_days }} siguientes, con percentil {{ peak_pct }} o más. Cada estación usa nivel o caudal, el que tenga más datos en la ventana.</li>
<li>La matriz se descarga en <a href="{{ base }}/{{ csv_path }}">CSV</a>: una fila por estación y día, con la media del día y su percentil.</li>
{% endblock %}
{% block scripts %}
<script type="application/json" id="crecida-datos">{{ data }}</script>
<script>
(function () {
  "use strict";
  document.documentElement.classList.add("js");  // the selection outline and the row pointer need this script
  var D = JSON.parse(document.getElementById("crecida-datos").textContent);
  var n = D.days.length;
  var box = document.getElementById("dia-control"), inp = document.getElementById("dia");
  var out = document.getElementById("dia-txt"), svg = document.getElementById("perfil-dia");
  if (!n || !inp || !svg) return;
  box.hidden = false;
  document.getElementById("dia-perfil").hidden = false;
  var NS = "http://www.w3.org/2000/svg";
  var cur = n - 1;

  function el(tag, attrs, text) {
    var e = document.createElementNS(NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    if (text != null) e.textContent = text;
    return e;
  }
  function dayText(i) {
    var p = D.days[i].split("-");
    return (+p[2]) + " de " + D.months[+p[1] - 1] + (D.partial && i === n - 1 ? D.partialText : "");
  }
  function moveSelection(i) {
    var hovs = document.querySelectorAll("svg.hov");
    for (var h = 0; h < hovs.length; h++) {
      var row = hovs[h].querySelector('.hit[data-i="' + i + '"]'), sel = hovs[h].querySelector(".sel");
      if (row && sel) sel.setAttribute("y", row.getAttribute("y"));
    }
  }
  function draw(i) {
    cur = i;
    out.textContent = dayText(i);
    moveSelection(i);
    // The viewBox follows the drawn width, so 12-unit text is 12 px on any screen.
    var W = Math.max(280, Math.round(svg.getBoundingClientRect().width) || 1100);
    var narrow = W < 600;
    var cities = D.rows.filter(function (r) { return r.city && r.p[i] != null; });
    // Narrow: one label row per city above the plot (rightmost city on top), each with a leader.
    var ROW = 14, T = narrow ? 18 + ROW * cities.length : 30;
    var L = narrow ? 34 : 64, R = narrow ? 8 : 24, PH = 200, H = T + PH + 20;
    var X = function (k) { return L + k / D.kmMax * (W - L - R); };
    var Y = function (p) { return T + (100 - Math.max(50, p)) / 50 * PH; };
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    svg.setAttribute("viewBox", "0 0 " + W + " " + H);
    for (var p = 50; p <= 100; p += 10) {
      svg.appendChild(el("line", {"class": "g", x1: L, x2: W - R, y1: Y(p), y2: Y(p)}));
      svg.appendChild(el("text", {"class": "ax", x: L - 8, y: Y(p) + 4, "text-anchor": "end"}, p === 50 ? "≤ 50" : String(p)));
    }
    var pts = [], said = [];
    D.rows.forEach(function (r) {
      if (r.p[i] != null) pts.push(X(r.km).toFixed(1) + "," + Y(r.p[i]).toFixed(1));
    });
    if (pts.length) svg.appendChild(el("polyline", {"class": "ln", points: pts.join(" ")}));
    var placed = [];
    function free(left, w, ty) {
      return !placed.some(function (b) { return left < b[1] && left + w > b[0] && ty - 13 < b[3] && ty + 3 > b[2]; });
    }
    function clampX(l, w) { return Math.max(2, Math.min(l, W - 2 - w)); }
    cities.forEach(function (r, k) {
      var v = r.p[i], x = X(r.km), y = Y(v), label = r.city + " P" + Math.floor(v), w = label.length * 6.6;
      var left, ty;
      if (narrow) {
        // Row k from the bottom: a leader only crosses rows of cities further left, whose names end left of it.
        ty = 13 + ROW * (cities.length - 1 - k);
        left = x - 4 - w >= 2 ? x - 4 - w : clampX(x + 4, w);
        svg.appendChild(el("line", {"class": "lead", x1: x.toFixed(1), x2: x.toFixed(1), y1: (ty + 3).toFixed(1), y2: (y - 5).toFixed(1)}));
      } else {
        // Wide, as the mockup: next to the point, moving up a line (then below) to clear earlier labels.
        var sides = [clampX(x + 6, w), clampX(x - 6 - w, w)], tys = [], j;
        for (j = 0; j < 6; j++) tys.push(y - 8 - ROW * j);
        for (j = 0; j < 4; j++) tys.push(y + 20 + ROW * j);
        tys = tys.filter(function (t) { return t - 13 >= 0 && t + 3 <= H; });
        if (!tys.length) tys = [Math.min(Math.max(13, y - 8), H - 3)];
        left = sides[0]; ty = tys[0];
        search: for (var a = 0; a < tys.length; a++) {
          for (var b = 0; b < 2; b++) {
            if (free(sides[b], w, tys[a])) { left = sides[b]; ty = tys[a]; break search; }
          }
        }
      }
      placed.push([left, left + w, ty - 12, ty + 2]);
      svg.appendChild(el("circle", {"class": "pt", cx: x.toFixed(1), cy: y.toFixed(1), r: 4}));
      svg.appendChild(el("text", {"class": "ax", x: left.toFixed(1), y: ty.toFixed(1)}, label));
      said.push(label);
    });
    if (!pts.length) svg.appendChild(el("text", {"class": "ax", x: W / 2, y: T + PH / 2, "text-anchor": "middle"}, "Sin datos ese día."));
    svg.setAttribute("aria-label", "Perfil del río el " + dayText(i) + (said.length ? ": " + said.join(", ") : "") + ".");
  }
  inp.addEventListener("input", function () { draw(+inp.value); });
  var hits = document.querySelectorAll("svg.hov .hit");
  for (var h = 0; h < hits.length; h++) {
    hits[h].addEventListener("click", function () { inp.value = this.getAttribute("data-i"); draw(+inp.value); });
  }
  var pending = 0;
  window.addEventListener("resize", function () {
    cancelAnimationFrame(pending);
    pending = requestAnimationFrame(function () { draw(cur); });
  });
  draw(cur);
})();
</script>
{% endblock %}
