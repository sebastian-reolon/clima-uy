{% extends "base.html.j2" %}
{# Sheet 1: the river in front of the Uruguayan cities. Ported from docs/design/plano-mockup.html.
   «—» marks an empty table cell, as in the mockup; it is never used in prose. #}
{% block title %}El río Uruguay frente a las ciudades uruguayas | clima-uy{% endblock %}
{% block description %}{{ headline[0] }} Nivel del río Uruguay frente a Bella Unión, Artigas, Salto, Paysandú y Fray Bentos comparado con su historia, río arriba y El Niño.{% endblock %}
{% block main %}
<div class="cab">
<section class="resp"><h1>{{ headline[0] }}</h1>
{% if headline[1] %}<p>{{ headline[1] }}</p>{% endif %}
</section>
<dl class="cajetin">
{% for label, value in cajetin %}
<dt>{{ label }}</dt><dd>{{ value }}</dd>
{% endfor %}
</dl>
</div>
<section class="sec"><h2>Ciudades uruguayas</h2>
<p class="que">Nivel en la regla de enfrente. Percentil: qué parte de los días desde {{ baseline_year }} estuvo más bajo. Cada regla tiene su propio cero, así que los metros no se comparan entre filas.</p>
<div class="tw"><table class="ciu">
<thead><tr><th>Ciudad</th><th>Regla</th><th class="n">Nivel</th><th class="n">Δ 3 días (m)</th><th class="n">Percentil</th><th class="n">Alerta (m)</th><th class="n">Falta (m)</th></tr></thead>
<tbody>
{% for r in city_rows %}
{% if r.gauge is none %}
<tr class="sin"><th scope="row">{{ r.city }}</th><td>sin regla pública</td><td class="obs" colspan="5">{{ r.near }}</td></tr>
{% else %}
<tr{% if r.cls %} class="{{ r.cls }}"{% endif %}><th scope="row">{{ r.city }}</th><td data-l="Regla">{{ r.gauge }}</td><td class="n" data-l="Nivel">{{ r.reading }}</td><td class="n d3" data-l="Δ 3 días">{{ r.d3 or "—" }}</td><td class="n" data-l="Percentil">{% if r.pct %}{{ r.pct }} <span class="bar"><span style="width:{{ r.bar }}%"></span></span>{% else %}—{% endif %}</td><td class="n" data-l="Alerta">{{ r.alert or "—" }}</td><td class="n strong" data-l="Falta">{{ r.falta or "—" }}</td></tr>
{% endif %}
{% endfor %}
</tbody></table></div>
</section>
<section class="sec"><h2>Perfil del río hoy</h2>
<p class="que">Cada estación comparada con su propia historia, de las represas de Brasil a Nueva Palmira.</p>
{{ profile_wide }}{{ profile_phone }}
<p class="ley"><span><i></i>hoy</span><span><i class="d"></i>hace 3 días</span><span><i class="u"></i>tramo con costa uruguaya</span><span>línea punteada en 90: el 10% de los días más altos</span></p>
</section>
<div class="dos">
<section class="sec"><h2>Aguas arriba</h2>
<p class="que">Lo que pasa antes de llegar a Bella Unión.</p>
{% if upstream_rows %}
<div class="tw"><table><thead><tr><th>Estación</th><th class="n">Nivel</th><th class="n">Δ 3 días (m)</th><th class="n">Percentil</th></tr></thead><tbody>
{% for r in upstream_rows %}
<tr><th scope="row">{{ r.name }}</th><td class="n">{{ r.reading }}</td><td class="n d3">{{ r.d3 or "—" }}</td><td class="n">{{ r.pct or "—" }}</td></tr>
{% endfor %}
</tbody></table></div>
{% else %}
<p>No hay estaciones río arriba con datos al día.</p>
{% endif %}
<p class="mas"><a href="{{ base }}/rio/">Pronósticos del INA y GloFAS, y crecidas de 2009, 2015 y 2023</a></p>
</section>
<section class="sec"><h2>El Niño</h2>
{% if enso_kv.period %}
<p class="que">Anomalía del Pacífico central, {{ enso_kv.period }}, y perspectiva de INUMET.</p>
{% else %}
<p class="que">Todavía no hay índices de la NOAA cargados. Abajo, la perspectiva de INUMET.</p>
{% endif %}
<dl class="kv">{% for label, value in enso_kv.rows %}<dt>{{ label }}</dt><dd>{{ value }}</dd>{% endfor %}</dl>
<p><a href="{{ base }}/nino/">Por qué los dos índices dan distinto</a></p>
</section>
</div>
<section class="sec"><h2>Todas las estaciones</h2>
{% if all_rows %}
<details><summary>Ver las {{ all_rows | length }} reglas en orden aguas abajo</summary><div class="tw"><table>
<thead><tr><th>Estación</th><th class="n">Hoy</th><th class="n">Δ 3 días (m)</th><th class="n">Percentil</th><th class="n">Alerta (m)</th></tr></thead><tbody>
{% for r in all_rows %}
<tr{% if r.al %} class="al"{% endif %}><th scope="row">{{ r.name }}<span class="pais">{{ r.where }}</span></th><td class="n">{{ r.today }}</td><td class="n">{{ r.d3 or "—" }}</td><td class="n">{{ r.pct or "—" }}</td><td class="n">{{ r.alert or "—" }}</td></tr>
{% endfor %}
</tbody></table></div></details>
{% else %}
<p>No hay estaciones con datos al día.</p>
{% endif %}
</section>
{% endblock %}
{% block notes %}
{% if notes.cotas %}
<li>Las cotas oficiales uruguayas se miden en la regla de cada ciudad: {{ notes.cotas.list }} (<a href="{{ notes.cotas.url }}">{{ notes.cotas.source }}</a>, {{ notes.cotas.date }}). No se comparan con las reglas de enfrente.</li>
{% endif %}
{% for text in notes.others %}
<li>{{ text }}</li>
{% endfor %}
<li>Los datos crudos de todas las fuentes se descargan en <a href="{{ base }}/datos/">Datos</a>.</li>
{% endblock %}
